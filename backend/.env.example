# ==============================================================================
# Variables de Entorno del Backend — SaldoMetria
# ==============================================================================

# Entorno: 'development' o 'production'
NODE_ENV=production

# Puerto del servidor Express
PORT=3000

# Base de datos MySQL
DB_NAME=saldometria_db
DB_USER=saldometria_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave secreta para firma de JSON Web Tokens (mínimo 32 caracteres aleatorios)
JWT_SECRET=GENERAR_CADENA_ALEATORIA_MUY_LARGA_Y_SEGURA_AQUI

# Tiempo de expiración del token JWT (ej. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Orígenes CORS permitidos (separados por coma en producción)
CORS_ORIGIN=https://saldometria.tudominio.com

# Nivel de log Winston ('info', 'warn', 'error', 'debug')
LOG_LEVEL=info

# API Key y Modelo de Groq para categorización inteligente asistida por IA (Opcional)
GROQ_API_KEY=gsk_tu_api_key_de_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Código de invitación obligatorio para el registro de nuevos usuarios (Opcional, dejar vacío si no se requiere)
INVITATION_CODE=TU_CODIGO_DE_INVITACION_AQUI
